{
  "name": "anki-template-code-editor",
  "version": "2.3.4",
  "description": "This add-on upgrades the text area in **Cards…** with the bundled Monaco editor for front templates, back templates, and card styling.",
  "private": true,
  "scripts": {
    "build": "npm run build:editor && npm run package:addon",
    "build:ankiweb": "npm run build:editor && npm run package:ankiweb",
    "build:editor": "vite build",
    "package:addon": "node scripts/package-addon.mjs",
    "package:ankiweb": "node scripts/package-addon.mjs --ankiweb",
    "version:set": "node scripts/set-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SelfishPig/AnkiCode.git"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/SelfishPig/AnkiCode/issues"
  },
  "homepage": "https://github.com/SelfishPig/AnkiCode#readme",
  "devDependencies": {
    "fflate": "^0.8.3",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.0"
  }
}
